{
  "name": "freellm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --local --port 8788",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.test.json && node scripts/test-pkg.cjs && node --test build-test/",
    "test:watch": "tsc -p tsconfig.test.json --watch --preserveWatchOutput & node --test --watch build-test/",
    "preview": "vite preview",
    "db:create": "wrangler d1 create hasit-in",
    "db:migrate:local": "wrangler d1 migrations apply hasit-in --local",
    "db:migrate:remote": "wrangler d1 migrations apply hasit-in --remote",
    "deploy": "npm run build && wrangler pages deploy dist --branch=main"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^5.20261010.1"
  }
}
